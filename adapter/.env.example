HOST=127.0.0.1
PORT=8787

PENPOT_BASE_URL=http://localhost:9001
PENPOT_ACCESS_TOKEN=
# Needed only for the /api/export render endpoint, which requires a session cookie
# rather than the bearer access token above — see docs/penpot-rpc-notes.md.
PENPOT_BOT_EMAIL=
PENPOT_BOT_PASSWORD=
PENPOT_BOT_PROFILE_ID=
# Optional: the bot account's default project/team-scoped file this adapter instance operates on.
PENPOT_DEFAULT_PROJECT_ID=
PENPOT_TARGET_FILE_ID=

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADAPTER_READONLY_TOKEN=
ADAPTER_READWRITE_TOKEN=

# Phase 3 (use_figma interpreter). The SDK reads these exact env var names itself.
# `ANTHROPIC_AUTH_TOKEN` + `ANTHROPIC_BASE_URL` let you point at a relay/proxy instead of
# a dedicated key (sends `Authorization: Bearer`) — use `ANTHROPIC_API_KEY` alone instead
# if you have a real direct Anthropic key (sends `x-api-key`); see src/config.ts.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

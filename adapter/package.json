{
  "name": "figma-shape-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP adapter exposing Figma's Dev Mode MCP Server tool shape against a self-hosted Penpot backend",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/unit/**/*.test.ts",
    "test:integration": "node --env-file=.env --test --import tsx test/integration/**/*.test.ts",
    "test:live": "node --env-file=.env --test --import tsx test/live/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7",
    "@anthropic-ai/sdk": "^0.134.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
